{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRANBRIDGE",
  "version": "0.1.1",
  "identifier": "com.granbridge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GRANBRIDGE",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/granbridge"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
